{
  "meta": {
    "name": "Example CAN Profile",
    "version": "1.0",
    "description": "Demonstrates CAN ID + payload via JSON import"
  },

  "canIdLayouts": {
    "default": {
      "id": "default",
      "name": "Extended CAN ID",
      "format": "extended",
      "bitLength": 29,
      "fields": [
        {
          "name": "priority",
          "startBit": 26,
          "length": 3
        },
        {
          "name": "messageType",
          "startBit": 21,
          "length": 5
        },
        {
          "name": "sourceNode",
          "startBit": 13,
          "length": 8
        },
        {
          "name": "destinationNode",
          "startBit": 5,
          "length": 8
        }
      ]
    }
  },

  "frames": {
    "VehicleStatus": {
      "canIdLayout": "default",
      "signals": [
        {
          "name": "vehicleSpeed",
          "startByte": 0,
          "length": 2,
          "byteOrder": "little",
          "factor": 0.01,
          "offset": 0,
          "unit": "km/h"
        },
        {
          "name": "engineRpm",
          "startByte": 2,
          "length": 2,
          "byteOrder": "little",
          "factor": 1,
          "offset": 0,
          "unit": "rpm"
        },
        {
          "name": "gearRaw",
          "startByte": 4,
          "length": 1,
          "byteOrder": "little",
          "factor": 1,
          "offset": 0
        }
      ]
    }
  },

  "fieldTypes": {
    "GearType": {
      "kind": "enum",
      "values": {
        "0": "Neutral",
        "1": "Drive",
        "2": "Reverse",
        "3": "Park"
      }
    }
  },

  "derivedFields": [
    {
      "name": "gear",
      "source": "signal",
      "signal": "gearRaw",
      "fieldType": "GearType"
    },
    {
      "name": "overspeed",
      "source": "expression",
      "expression": "vehicleSpeed > 120",
      "fieldType": "boolean"
    }
  ],

  "columns": [
    {
      "label": "Time",
      "source": "frame",
      "key": "timestamp",
      "visible": true
    },
    {
      "label": "Source",
      "source": "canId",
      "field": "sourceNode",
      "visible": true
    },
    {
      "label": "Speed",
      "source": "signal",
      "signal": "vehicleSpeed",
      "unit": "km/h",
      "visible": true
    },
    {
      "label": "Gear",
      "source": "derived",
      "field": "gear",
      "visible": true
    },
    {
      "label": "Overspeed",
      "source": "derived",
      "field": "overspeed",
      "visible": true
    }
  ]
}
