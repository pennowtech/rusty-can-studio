{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rustycan.local/schemas/canonical-profile.schema.json",
  "title": "RustyCAN Canonical Profile",
  "description": "Protocol-neutral CAN/CAN-FD profile format used by the visual profile editor and decoder.",
  "type": "object",
  "required": ["schemaVersion", "meta", "bus", "layouts", "payload"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "bus": {
      "$ref": "#/$defs/bus"
    },
    "layouts": {
      "type": "object",
      "required": ["canId"],
      "additionalProperties": false,
      "properties": {
        "canId": {
          "$ref": "#/$defs/layout"
        }
      }
    },
    "dictionaries": {
      "type": "object",
      "description": "Reusable numeric-to-text lookup tables.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "default": {}
    },
    "payload": {
      "$ref": "#/$defs/payload"
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/errorRule"
      },
      "default": []
    },
    "display": {
      "$ref": "#/$defs/display"
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["id", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "bus": {
      "type": "object",
      "required": ["type", "idFormat", "byteOrder"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["can", "can-fd"]
        },
        "idFormat": {
          "enum": ["standard", "extended", "custom"]
        },
        "byteOrder": {
          "enum": ["little", "big"]
        }
      }
    },
    "layout": {
      "type": "object",
      "description": "Either an owned bit layout, or a { ref_file } pointer to another loaded profile's own layout of the same kind (canId, or payload.common) — see canonicalProfile.ts's CanonicalLayout doc.",
      "oneOf": [
        {
          "required": ["ref_file"],
          "additionalProperties": false,
          "properties": {
            "ref_file": {
              "type": "string",
              "description": "Filename of another loaded profile to inherit this layout from."
            }
          }
        },
        {
          "required": ["bitLength", "fields"],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "bitLength": {
              "type": "integer",
              "minimum": 0
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/field"
              }
            }
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "required": ["name", "startBit", "bitLength"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "label": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "startBit": {
          "type": "integer",
          "minimum": 0
        },
        "bitLength": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": ["uint", "int", "bool", "enum", "bytes", "string"],
          "default": "uint"
        },
        "dictionary": {
          "type": "string"
        },
        "factor": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "strideBits": {
          "type": "integer",
          "minimum": 1
        },
        "display": {
          "$ref": "#/$defs/displayValue"
        }
      }
    },
    "payload": {
      "type": "object",
      "description": "Payload decoding: fields common to every variant (decoded once), a discriminator naming which decoded values pick a variant, and the variants themselves.",
      "required": ["discriminator", "variants"],
      "additionalProperties": false,
      "properties": {
        "common": {
          "$ref": "#/$defs/layout",
          "description": "Decoded once per frame, ahead of variant selection. Omit for a profile with no shared payload fields (e.g. discriminated entirely off the CAN ID)."
        },
        "discriminator": {
          "type": "array",
          "description": "Ordered field names (from layouts.canId.fields and/or payload.common.fields) whose decoded values, joined with \":\", select a variants[] entry.",
          "items": {
            "type": "string"
          }
        },
        "variants": {
          "type": "object",
          "description": "Keyed by discriminator values joined with \":\" (e.g. \"6:0:1\"). An array value is only needed when discriminator equality alone can't disambiguate two variants — each entry's identifyWhen picks the right one.",
          "additionalProperties": {
            "oneOf": [
              { "$ref": "#/$defs/variant" },
              {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/variant" }
              }
            ]
          }
        }
      }
    },
    "variant": {
      "type": "object",
      "required": ["id", "label", "payload"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "identifyWhen": {
          "type": "string",
          "description": "Only meaningful when this variant shares its discriminator key with sibling entries in a variants[] array — the first entry whose identifyWhen passes (or has none) wins."
        },
        "payload": {
          "type": "object",
          "required": ["bitLength", "fields"],
          "additionalProperties": false,
          "properties": {
            "bitLength": {
              "type": "integer",
              "minimum": 0
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/field"
              }
            },
            "display": {
              "$ref": "#/$defs/displayValue"
            }
          }
        }
      }
    },
    "errorRule": {
      "type": "object",
      "required": ["id", "when", "source"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "when": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "required": ["startBit", "bitLength", "type"],
          "additionalProperties": false,
          "properties": {
            "startBit": {
              "type": "integer",
              "minimum": 0
            },
            "bitLength": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "enum": ["uint", "int"]
            },
            "byteOrder": {
              "enum": ["little", "big"]
            }
          }
        },
        "dictionary": {
          "type": "string"
        },
        "display": {
          "type": "string"
        }
      }
    },
    "displayValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expression": {
          "type": "string"
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "profileEditor": {
          "type": "object",
          "additionalProperties": true
        },
        "canMonitor": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
