{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusty-can-studio.local/schemas/canonical-profile.schema.json",
  "title": "Rusty CAN Studio Canonical Profile",
  "description": "Protocol-neutral CAN/CAN-FD profile format used by the visual profile editor and decoder.",
  "type": "object",
  "required": ["schemaVersion", "meta", "bus", "layouts", "messages"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "bus": {
      "$ref": "#/$defs/bus"
    },
    "layouts": {
      "type": "object",
      "required": ["canId"],
      "additionalProperties": false,
      "properties": {
        "canId": {
          "$ref": "#/$defs/layout"
        },
        "payloadHeader": {
          "$ref": "#/$defs/layout"
        }
      }
    },
    "dictionaries": {
      "type": "object",
      "description": "Reusable numeric-to-text lookup tables.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "default": {}
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/errorRule"
      },
      "default": []
    },
    "display": {
      "$ref": "#/$defs/display"
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["id", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "bus": {
      "type": "object",
      "required": ["type", "idFormat", "byteOrder"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["can", "can-fd"]
        },
        "idFormat": {
          "enum": ["standard", "extended", "custom"]
        },
        "byteOrder": {
          "enum": ["little", "big"]
        }
      }
    },
    "layout": {
      "type": "object",
      "required": ["bitLength", "fields"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "bitLength": {
          "type": "integer",
          "minimum": 0
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["name", "startBit", "bitLength"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "label": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "startBit": {
          "type": "integer",
          "minimum": 0
        },
        "bitLength": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": ["uint", "int", "bool", "enum", "bytes", "string"],
          "default": "uint"
        },
        "dictionary": {
          "type": "string"
        },
        "factor": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "strideBits": {
          "type": "integer",
          "minimum": 1
        },
        "display": {
          "$ref": "#/$defs/displayValue"
        }
      }
    },
    "message": {
      "type": "object",
      "required": ["id", "label", "identifyBy", "payload"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "identifyBy": {
          "type": "object",
          "description": "Decoded field values that identify this message.",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        },
        "identifyWhen": {
          "type": "string",
          "description": "Optional expression for advanced identification when identifyBy is not enough."
        },
        "payload": {
          "type": "object",
          "required": ["bitLength", "fields"],
          "additionalProperties": false,
          "properties": {
            "bitLength": {
              "type": "integer",
              "minimum": 0
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/field"
              }
            },
            "display": {
              "$ref": "#/$defs/displayValue"
            }
          }
        }
      }
    },
    "errorRule": {
      "type": "object",
      "required": ["id", "when", "source"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "when": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "required": ["startBit", "bitLength", "type"],
          "additionalProperties": false,
          "properties": {
            "startBit": {
              "type": "integer",
              "minimum": 0
            },
            "bitLength": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "enum": ["uint", "int"]
            },
            "byteOrder": {
              "enum": ["little", "big"]
            }
          }
        },
        "dictionary": {
          "type": "string"
        },
        "display": {
          "type": "string"
        }
      }
    },
    "displayValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expression": {
          "type": "string"
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "profileEditor": {
          "type": "object",
          "additionalProperties": true
        },
        "canMonitor": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
