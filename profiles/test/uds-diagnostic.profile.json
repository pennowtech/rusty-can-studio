{
  "schemaVersion": "1.0",
  "meta": {
    "id": "uds-diagnostic",
    "name": "UDS Diagnostic Request",
    "version": "1.0.0"
  },
  "bus": {
    "type": "can-fd",
    "idFormat": "extended",
    "byteOrder": "little"
  },
  "layouts": {
    "canId": {
      "label": "UDS 29-bit ID",
      "bitLength": 29,
      "fields": [
        { "name": "target_address", "startBit": 8, "bitLength": 8, "type": "uint" },
        { "name": "source_address", "startBit": 0, "bitLength": 8, "type": "uint" },
        { "name": "addressing_type", "startBit": 24, "bitLength": 5, "type": "uint" }
      ]
    },
    "payloadHeader": {
      "label": "Payload header",
      "bitLength": 16,
      "fields": [
        { "name": "payload_length", "startBit": 0, "bitLength": 8, "type": "uint" },
        { "name": "service_id", "startBit": 8, "bitLength": 8, "type": "enum", "dictionary": "service_id" }
      ]
    }
  },
  "dictionaries": {
    "service_id": { "34": "ReadDataByIdentifier" }
  },
  "messages": [
    {
      "id": "uds.read_data_by_identifier.request",
      "label": "Read DID request",
      "identifyBy": { "service_id": 34 },
      "payload": {
        "bitLength": 32,
        "fields": [
          { "name": "did", "startBit": 16, "bitLength": 16, "type": "uint" }
        ]
      }
    }
  ],
  "errors": [],
  "display": {}
}
